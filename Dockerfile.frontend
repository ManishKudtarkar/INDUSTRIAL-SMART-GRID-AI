# ── Frontend Dockerfile (multi-stage) ────────────────────────────────────────
# Stage 1: Build the React app
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies
# Use npm install (not npm ci) — more tolerant of lockfile mismatches
COPY dashboard/frontend/package*.json ./
RUN npm install --legacy-peer-deps

# Copy source
COPY dashboard/frontend/ ./

# VITE_API_BASE_URL injected at build time
# Inside Docker, nginx proxies API on same origin so this can be empty
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy built React files
COPY --from=builder /app/dist /usr/share/nginx/html

# nginx config: SPA routing + API proxy to backend
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
