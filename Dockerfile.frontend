# ── Frontend Dockerfile (multi-stage) ────────────────────────────────────────
# Stage 1: Build the React app
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies (cached layer)
COPY dashboard/frontend/package*.json ./
RUN npm ci --silent

# Copy source and build
COPY dashboard/frontend/ ./

# VITE_API_BASE_URL is injected at build time via --build-arg
# Inside Docker network, frontend talks to backend via service name
ARG VITE_API_BASE_URL=http://backend:8000
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: Serve with nginx (tiny, production-ready)
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# nginx config: serve React SPA + proxy /api calls to backend
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
