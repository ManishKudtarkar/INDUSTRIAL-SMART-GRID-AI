{
  "name": "industrial-smart-grid-ai",
  "version": "1.0.0",
  "description": "Distributed AI-Powered Smart Grid Monitoring System",
  "main": "main.js",
  "author": "Manish Kudtarkar",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.manishkudtarkar.smartgridai",
    "productName": "Smart Grid AI",
    "copyright": "Copyright © 2026 Manish Kudtarkar",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "app",
        "filter": [
          "**/*",
          "!desktop/**",
          "!node_modules/**",
          "!dashboard/frontend/node_modules/**",
          "!.git/**",
          "!*.bat",
          "!.pytest_cache/**",
          "!**/.pytest_cache/**",
          "!testing/**",
          "!landing/**",
          "!desktop/dist/**",
          "!__pycache__/**",
          "!**/__pycache__/**",
          "!*.pyc"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smart Grid AI",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}
